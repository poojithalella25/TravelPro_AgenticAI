# FastAPI Server Port
PORT=8000

# LangGraph AI LLM Configuration
# Provide either GROQ_API_KEY, GEMINI_API_KEY or OPENAI_API_KEY.
# If none are provided, the backend falls back to simulated/deterministic agent responses for demo.
GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# Configurable model name (e.g. llama3-70b-8192, gemini-1.5-flash, gpt-4o)
LLM_MODEL=llama3-70b-8192

# MongoDB Connection
# If left empty, the application uses an in-memory/local JSON database (local_db.json)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/travel_planner?retryWrites=true&w=majority

# JWT Token Secret for Auth
JWT_SECRET=super_secret_jwt_token_for_btech_travel_planner_2026

# External API Keys (Optional)
# If left empty, the weather service generates realistic simulated conditions.
WEATHER_API_KEY=
